            {
              "id": "condition1",
              "leftValue": "={{ $json.tier }}",
              "rightValue": "Filtered",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
