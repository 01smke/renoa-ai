            "Address": "={{$json.address}}",
            "City": "={{$json.city}}",
            "State": "={{$json.state}}",
            "Zip": "={{$json.zip}}",
            "Property Value": "={{$json.property_value}}",
            "Property Age": "={{new Date().getFullYear() - ($json.year_built || new Date().getFullYear())}}",
            "Lot Size": "={{$json.lot_size_acres}}",
            "Contact Name": "={{$json.contact_name || ''}}",
            "Phone": "={{$json.phone || ''}}",
